# YAML Linting Configuration
---
extends: default

rules:
  line-length:
    max: 120
    level: warning
  indentation:
    spaces: 2
  comments:
    min-spaces-from-content: 2
  comments-indentation: {}
  truthy:
    allowed:
      - true
      - false
      - "yes"
      - "no"
    check-keys: false

ignore: |
  .terraform/
  **/*.md
