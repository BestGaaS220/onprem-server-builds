# Fail2ban jail configuration
# Generated by Ansible on {{ ansible_date_time.iso8601 }}

[DEFAULT]
# Default action - ban and send email notification
banaction = ufw
banaction_allports = ufw
bantime = 3600
findtime = 600
maxretry = 3
destemail = root@localhost
sendername = Fail2Ban
action = %(banaction)s[name=%(__name__)s, port="%(port)s", protocol="%(protocol)s", chain="%(chain)s"]
         %(mta)s-whois[name=%(__name__)s, dest="%(destemail)s", protocol="%(protocol)s"]

# Logging
logpath = /var/log/fail2ban.log
loglevel = INFO

{% for jail_name, jail_config in fail2ban_jails.items() %}
[{{ jail_name }}]
{% if jail_config.enabled %}
enabled = true
{% else %}
enabled = false
{% endif %}
{% if jail_config.port is defined %}
port = {{ jail_config.port }}
{% endif %}
{% if jail_config.logpath is defined %}
logpath = {{ jail_config.logpath }}
{% endif %}
{% if jail_config.maxretry is defined %}
maxretry = {{ jail_config.maxretry }}
{% endif %}
{% if jail_config.findtime is defined %}
findtime = {{ jail_config.findtime }}
{% endif %}
{% if jail_config.bantime is defined %}
bantime = {{ jail_config.bantime }}
{% endif %}
{% if jail_config.action is defined %}
action = {{ jail_config.action }}
{% endif %}

{% endfor %}
