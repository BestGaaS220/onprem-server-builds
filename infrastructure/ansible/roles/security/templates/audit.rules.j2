# Audit rules for system auditing
# Generated by Ansible on {{ ansible_date_time.iso8601 }}

# Remove any existing rules
-D

# Buffer Size
-b {{ audit_rules[0].rules[0] | regex_replace('-b ', '') }}

# Failure Mode
{{ audit_rules[0].rules[1] }}

# Enable Auditing
{{ audit_rules[0].rules[2] }}

# Execution tracking
-a always,exit -F arch=b64 -S execve -F uid>=1000 -F auid>=1000 -k exec
-a always,exit -F arch=b32 -S execve -F uid>=1000 -F auid>=1000 -k exec

# File access auditing
-a always,exit -F arch=b64 -S open,openat -F exit=-EACCES -F auid>=1000 -k access
-a always,exit -F arch=b32 -S open,openat -F exit=-EACCES -F auid>=1000 -k access
-a always,exit -F arch=b64 -S open,openat -F exit=-EPERM -F auid>=1000 -k access
-a always,exit -F arch=b32 -S open,openat -F exit=-EPERM -F auid>=1000 -k access

# Administrative access
-a always,exit -F path=/etc/sudoers -F perm=wa -F auid>=1000 -F auid!=4294967295 -k scope
-a always,exit -F path=/etc/sudoers.d -F perm=wa -F auid>=1000 -F auid!=4294967295 -k scope

# Modifications to user/group files
-a always,exit -F arch=b64 -S adjtimex,settimeofday -k time-change
-a always,exit -F arch=b32 -S adjtimex,settimeofday,stime -k time-change
-a always,exit -F arch=b64 -S clock_settime -F a0>=0xbc -k time-change
-a always,exit -F arch=b32 -S clock_settime -F a0=0xbc -k time-change
-a always,exit -F arch=b64 -S clock_settime -F a0=0x0 -k time-change
-a always,exit -F arch=b32 -S clock_settime -F a0=0x0 -k time-change

# User and group modifications
-a always,exit -F arch=b64 -S sethostname,setdomainname -k network_modifications
-a always,exit -F arch=b32 -S sethostname,setdomainname -k network_modifications

# Network modifications
-a always,exit -F dev=lo -S all -F auid>=1000 -F auid!=4294967295 -k lo-changes
-a always,exit -F net -S all -F auid>=1000 -F auid!=4294967295 -k network-modifications

# File deletion
-a always,exit -F arch=b64 -S unlink,unlinkat,rename,renameat -F auid>=1000 -F auid!=4294967295 -k delete
-a always,exit -F arch=b32 -S unlink,unlinkat,rename,renameat -F auid>=1000 -F auid!=4294967295 -k delete

# System administration
-a always,exit -F arch=b64 -S sysctl -F auid>=1000 -F auid!=4294967295 -k scope
-a always,exit -F arch=b32 -S sysctl -F auid>=1000 -F auid!=4294967295 -k scope

# Make configuration immutable
-e 2
