# SSHD Configuration
# Automatically generated by Ansible and managed by configuration management
# DO NOT EDIT THIS FILE DIRECTLY - See /etc/ssh/sshd_config.bak for original

# ============================================================================
# Port and Address
# ============================================================================
Port 22
#AddressFamily any
ListenAddress 0.0.0.0
ListenAddress ::

# ============================================================================
# Authentication
# ============================================================================
PermitRootLogin {{ ssh_config.PermitRootLogin }}
PubkeyAuthentication {{ ssh_config.PubkeyAuthentication }}
PasswordAuthentication {{ ssh_config.PasswordAuthentication }}
PermitEmptyPasswords {{ ssh_config.PermitEmptyPasswords }}
MaxAuthTries {{ ssh_config.MaxAuthTries }}
MaxSessions {{ ssh_config.MaxSessions }}

# Disable other authentication methods
ChallengeResponseAuthentication no
UsePAM yes
AuthenticationMethods publickey

# ============================================================================
# Protocol and Ciphers
# ============================================================================
Protocol {{ ssh_config.Protocol }}
Ciphers {{ ssh_config.Ciphers }}
MACs {{ ssh_config.MACs }}
KexAlgorithms {{ ssh_config.KexAlgorithms }}
HostKeyAlgorithms ssh-ed25519,rsa-sha2-512,rsa-sha2-256

# ============================================================================
# Logging and Monitoring
# ============================================================================
SyslogFacility {{ ssh_config.SyslogFacility }}
LogLevel {{ ssh_config.LogLevel }}
UseDNS {{ ssh_config.UseDNS }}

# ============================================================================
# Security Options
# ============================================================================
X11Forwarding {{ ssh_config.X11Forwarding }}
X11UseLocalhost yes
PermitUserEnvironment {{ ssh_config.PermitUserEnvironment }}
UseLogin {{ ssh_config.UseLogin }}
Compression {{ ssh_config.Compression }}
ClientAliveInterval {{ ssh_config.ClientAliveInterval }}
ClientAliveCountMax {{ ssh_config.ClientAliveCountMax }}
TCPKeepAlive {{ ssh_config.TCPKeepAlive }}

# Disable unsafe options
AllowAgentForwarding no
AllowTcpForwarding no
PermitTunnel no
GatewayPorts no

# ============================================================================
# Subsystem
# ============================================================================
Subsystem sftp	/usr/lib/openssh/sftp-server -f AUTHPRIV -l INFO

# ============================================================================
# Banner and MOTD
# ============================================================================
Banner /etc/ssh/banner
PrintMotd no
PrintLastLog yes

# ============================================================================
# End of configuration
# ============================================================================
