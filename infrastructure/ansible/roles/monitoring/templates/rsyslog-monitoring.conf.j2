# Rsyslog monitoring configuration
# Generated by Ansible on {{ ansible_date_time.iso8601 }}

# Network listener for monitoring
module(load="imudp")
module(load="imtcp")

input(type="imudp" address="{{ rsyslog_bind_address }}" port="{{ rsyslog_bind_port }}")
input(type="imtcp" address="{{ rsyslog_bind_address }}" port="{{ rsyslog_bind_port }}")

# Add hostname and priority to all messages
$template MonitorFormat,"%HOSTNAME% %syslogtag% %msg%\n"

# Forward to monitoring system
action(type="omfwd" target="monitoring.example.com" port="514" protocol="udp"
       action.resumeRetryCount="3"
       queue.type="LinkedList"
       queue.maxdiskspace="1g")

# Local monitoring file
local0.* /var/log/monitoring/messages

# Include d directory
$IncludeConfig /etc/rsyslog.d/*.conf
