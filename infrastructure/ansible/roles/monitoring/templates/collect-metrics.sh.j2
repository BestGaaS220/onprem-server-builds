#!/bin/bash
# Custom metrics collection script
# Generated by Ansible on {{ ansible_date_time.iso8601 }}

set -euo pipefail

METRICS_DIR="/opt/metrics"
METRICS_FILE="$METRICS_DIR/custom-metrics.txt"

# Collect system metrics
collect_metrics() {
  local timestamp=$(date +%s)
  
  # CPU metrics
  local cpu_Count=$(nproc --all)
  local cpu_usage=$(top -bn1 | grep "Cpu(s)" | sed "s/.*, *\([0-9.]*\)%* id.*/\1/" | awk '{print 100 - $1}')
  
  # Memory metrics
  local mem_total=$(free -m | awk '/Mem:/ {print $2}')
  local mem_used=$(free -m | awk '/Mem:/ {print $3}')
  local mem_free=$(free -m | awk '/Mem:/ {print $4}')
  
  # Disk metrics
  local disk_total=$(df / | awk 'NR==2 {print $2}')
  local disk_used=$(df / | awk 'NR==2 {print $3}')
  local disk_free=$(df / | awk 'NR==2 {print $4}')
  
  # Write metrics to temporary file
  {
    echo "# HELP system_cpu_cores Total CPU cores"
    echo "# TYPE system_cpu_cores gauge"
    echo "system_cpu_cores $cpu_Count"
    echo ""
    echo "# HELP system_cpu_usage CPU usage percentage"
    echo "# TYPE system_cpu_usage gauge"
    echo "system_cpu_usage $cpu_usage"
    echo ""
    echo "# HELP system_memory_total_bytes Total memory in bytes"
    echo "# TYPE system_memory_total_bytes gauge"
    echo "system_memory_total_bytes $((mem_total * 1024 * 1024))"
    echo ""
    echo "# HELP system_memory_used_bytes Used memory in bytes"
    echo "# TYPE system_memory_used_bytes gauge"
    echo "system_memory_used_bytes $((mem_used * 1024 * 1024))"
    echo ""
    echo "# HELP system_memory_free_bytes Free memory in bytes"
    echo "# TYPE system_memory_free_bytes gauge"
    echo "system_memory_free_bytes $((mem_free * 1024 * 1024))"
    echo ""
    echo "# HELP system_disk_total_bytes Total disk space in bytes"
    echo "# TYPE system_disk_total_bytes gauge"
    echo "system_disk_total_bytes $((disk_total * 1024))"
    echo ""
    echo "# HELP system_disk_used_bytes Used disk space in bytes"
    echo "# TYPE system_disk_used_bytes gauge"
    echo "system_disk_used_bytes $((disk_used * 1024))"
    echo ""
    echo "# HELP system_disk_free_bytes Free disk space in bytes"
    echo "# TYPE system_disk_free_bytes gauge"
    echo "system_disk_free_bytes $((disk_free * 1024))"
  } > "$METRICS_FILE.tmp"
  
  mv "$METRICS_FILE.tmp" "$METRICS_FILE"
}

collect_metrics
