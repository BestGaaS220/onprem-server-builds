# Logrotate configuration
# {{ section | default('Application logs') }}
# Generated by Ansible on {{ ansible_date_time.iso8601 }}

/var/log/{{ item }}/*.log {
  daily
  rotate {{ logrotate_retention }}
  missingok
  notifempty
  {% if logrotate_compress %}compress{% endif %}
  delaycompress
  postrotate
    systemctl reload {{ item }} > /dev/null 2>&1 || true
  endscript
  sharedscripts
  create 0640 root adm
}
