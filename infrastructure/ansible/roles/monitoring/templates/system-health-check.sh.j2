#!/bin/bash
# System health check script
# Generated by Ansible on {{ ansible_date_time.iso8601 }}

set -o pipefail

# Colors for output
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m' # No Color

# Thresholds
CPU_THRESHOLD={{ cpu_alert_threshold }}
MEMORY_THRESHOLD={{ memory_alert_threshold }}
DISK_THRESHOLD={{ disk_alert_threshold }}
LOAD_THRESHOLD={{ load_alert_threshold }}

# Logging
LOG_FILE="/var/log/system-health.log"

log_message() {
  echo "[$(date +'%Y-%m-%d %H:%M:%S')] $1" | tee -a "$LOG_FILE"
}

check_cpu() {
  local cpu_usage=$(top -bn1 | grep "Cpu(s)" | sed "s/.*, *\([0-9.]*\)%* id.*/\1/" | awk '{print 100 - $1}')
  if (( $(echo "$cpu_usage > $CPU_THRESHOLD" | bc -l) )); then
    echo -e "${RED}WARN${NC}: CPU usage high: ${cpu_usage}%"
    log_message "WARNING: CPU usage high: ${cpu_usage}%"
  else
    echo -e "${GREEN}OK${NC}: CPU usage: ${cpu_usage}%"
  fi
}

check_memory() {
  local memory_usage=$(free | grep Mem | awk '{printf("%.0f", 100 * $3/$2)}')
  if (( memory_usage > MEMORY_THRESHOLD )); then
    echo -e "${RED}WARN${NC}: Memory usage high: ${memory_usage}%"
    log_message "WARNING: Memory usage high: ${memory_usage}%"
  else
    echo -e "${GREEN}OK${NC}: Memory usage: ${memory_usage}%"
  fi
}

check_disk() {
  local disk_usage=$(df -h / | tail -1 | awk '{print $5}' | sed 's/%//')
  if (( disk_usage > DISK_THRESHOLD )); then
    echo -e "${RED}WARN${NC}: Disk usage high: ${disk_usage}%"
    log_message "WARNING: Disk usage high: ${disk_usage}%"
  else
    echo -e "${GREEN}OK${NC}: Disk usage: ${disk_usage}%"
  fi
}

check_load() {
  local load=$(uptime | awk -F'load average:' '{ print $NF }' | awk '{print $1}')
  if (( $(echo "$load > $LOAD_THRESHOLD" | bc -l) )); then
    echo -e "${RED}WARN${NC}: Load average high: ${load}"
    log_message "WARNING: Load average high: ${load}"
  else
    echo -e "${GREEN}OK${NC}: Load average: ${load}"
  fi
}

check_services() {
  local critical_services=(sshd node-exporter rsyslog)
  for service in "${critical_services[@]}"; do
    if systemctl is-active --quiet "$service"; then
      echo -e "${GREEN}OK${NC}: Service $service is running"
    else
      echo -e "${RED}ERROR${NC}: Service $service is not running"
      log_message "ERROR: Service $service is not running"
    fi
  done
}

# Run all checks
log_message "Starting system health check"
echo "=== System Health Check - $(date) ==="

check_cpu
check_memory
check_disk
check_load
check_services

log_message "System health check completed"
echo "=== Health check completed ==="
