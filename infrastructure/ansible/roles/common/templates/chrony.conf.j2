# Chrony NTP Configuration
# Generated by Ansible {{ ansible_date_time.iso8601 }}

# Pool configuration
{% for pool in ntp_pools %}
pool {{ pool }}
{% endfor %}

# This directive specifies the source of NTP signals
# We trust the time between steps
sourcedir /run/chrony-dhcp

# This option specifies the level of authentication required by ntp
keyfile /etc/chrony/chrony.keys

# The driftfile is where the frequency error of the system clock is stored
driftfile /var/lib/chrony/chrony.drift

# Logging configuration
logdir /var/log/chrony

# Time slewing - maximum allowed when correcting without stopping clock
maxupdateskew 100.0

# Threshold for logging step changes
makestep 1 3

# RTC synchronization
rtcfile /var/lib/chrony/rtc

# NTP authentication
authselectmode require

# Status reporting
allow 127.0.0.1
allow ::1

# Local reference clock
fudge 0.038
minsources 1

# Serving NTP to others
allow 10.0.0.0/8
allow 172.16.0.0/12
allow 192.168.0.0/16
allow fe80::/10

# Leap second smearing
leapsecmode slew
maxslewrate 1000

# TCP/UDP ports
cmdport 323
port 123

# System clock discipline tuning
minpoll 6
maxpoll 10
