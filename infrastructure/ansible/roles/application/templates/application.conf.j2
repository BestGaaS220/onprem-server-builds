# Application configuration
# Generated by Ansible on {{ ansible_date_time.iso8601 }}

# Basic Settings
app.name={{ app_name }}
app.version={{ app_version }}
app.environment={{ app_env }}
app.debug={{ app_debug }}

# Server
server.port={{ app_port }}
server.bind.address={{ app_bind_address }}
server.context.path={{ app_context }}
server.compression.enabled=true
server.compression.min-response-size=1024

# Application context
spring.application.name={{ app_name }}
spring.profiles.active={{ app_env }}

# Logging
logging.level.root={{ app_log_level }}
logging.file.name={{ app_log_dir }}/{{ app_name }}.log
logging.file.max-size=100MB
logging.file.max-history={{ app_logs_retention }}
logging.pattern.file=%d{yyyy-MM-dd HH:mm:ss} - %msg%n

# Database (if applicable)
{% if not db_managed %}
spring.datasource.url=jdbc:postgresql://{{ db_host }}:{{ db_port }}/{{ db_name }}
spring.datasource.username={{ db_user }}
spring.datasource.password={{ db_password }}
spring.datajpa.hibernate.ddl-auto=validate
{% endif %}

# Cache
spring.cache.type={{ cache_backend }}
spring.redis.host={{ cache_host }}
spring.redis.port={{ cache_port }}

# Health
management.endpoints.web.exposure.include=health,metrics,prometheus
management.endpoint.health.show-details=when-authorized
management.health.defaults.enabled=true

# Metrics
management.metrics.enable.all=true
management.endpoints.web.path-mapping.prometheus=metrics
