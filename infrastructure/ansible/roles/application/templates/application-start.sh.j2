#!/bin/bash
# Application startup script
# Generated by Ansible on {{ ansible_date_time.iso8601 }}

set -euo pipefail

# Load environment
source "{{ app_home }}/.env"

# Application variables
APP_HOME="{{ app_home }}"
APP_LIB="$APP_HOME/lib"
APP_CONF="$APP_HOME/conf"
APP_LOG="{{ app_log_dir }}"
APP_BIN="$APP_HOME/bin"

# Logging setup
exec 1>> "$APP_LOG/startup.log"
exec 2>&1

# Log function
log() {
  echo "[$(date +'%Y-%m-%d %H:%M:%S')] $*"
}

log "Starting {{ app_name }} application..."
log "Version: $APP_VERSION"
log "Environment: $APP_ENV"

# Pre-flight checks
if [[ ! -d "$APP_HOME" ]]; then
  log "ERROR: Application home not found: $APP_HOME"
  exit 1
fi

if [[ ! -f "$APP_CONF/application.conf" ]]; then
  log "ERROR: Configuration file not found: $APP_CONF/application.conf"
  exit 1
fi

# Setup classpath (if binary deployment)
{% if app_deployment_type == 'binary' %}
CLASSPATH="$APP_LIB/*:$APP_CONF"
export CLASSPATH

# JVM options
JVM_OPTS="-Xms{{ jvm_heap_min }} -Xmx{{ jvm_heap_max }} {{ jvm_gc_type }}"
JVM_OPTS="$JVM_OPTS -Djava.awt.headless=true"
JVM_OPTS="$JVM_OPTS -Dfile.encoding=UTF-8"
JVM_OPTS="$JVM_OPTS -Djava.net.preferIPv4Stack=true"

export JVM_OPTS

log "JVM Options: $JVM_OPTS"
log "Java version: $(java -version 2>&1 | head -1)"

# Start application
cd "$APP_HOME"
java $JVM_OPTS -cp "$CLASSPATH" com.elevatediq.Application
{% else %}
# For other deployment types, invoke application directly
cd "$APP_HOME"
./bin/elevatediq-app
{% endif %}
