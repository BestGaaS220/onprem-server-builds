#!/bin/bash
# Application health check script
# Generated by Ansible on {{ ansible_date_time.iso8601 }}

set -euo pipefail

HEALTH_URL="{{ app_protocol }}://{{ app_bind_address if app_bind_address != '0.0.0.0' else 'localhost' }}:{{ app_port }}{{ health_check_path }}"
MAX_RETRIES=5
RETRY_DELAY=2

log() {
  echo "[$(date +'%Y-%m-%d %H:%M:%S')] $*" >&2
}

check_health() {
  local attempt=1
  
  while [[ $attempt -le $MAX_RETRIES ]]; do
    log "Health check attempt $attempt of $MAX_RETRIES..."
    
    response=$(curl -s -w "%{http_code}" -o /dev/null "$HEALTH_URL" 2>/dev/null || echo "000")
    
    if [[ "$response" == "200" ]]; then
      log "Health check PASSED (HTTP $response)"
      return 0
    else
      log "Health check FAILED (HTTP $response)"
      if [[ $attempt -lt $MAX_RETRIES ]]; then
        sleep $RETRY_DELAY
      fi
    fi
    
    ((attempt++))
  done
  
  log "Health check failed after $MAX_RETRIES attempts"
  return 1
}

# Run health check
if check_health; then
  exit 0
else
  exit 1
fi
