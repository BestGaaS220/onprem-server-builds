# Application environment configuration
# Generated by Ansible on {{ ansible_date_time.iso8601 }}

# Application
APP_NAME={{ app_name }}
APP_VERSION={{ app_version }}
APP_ENV={{ app_env }}
APP_DEBUG={{ app_debug | lower }}
APP_LOG_LEVEL={{ app_log_level }}

# Server
SERVER_PORT={{ app_port }}
SERVER_BIND_ADDRESS={{ app_bind_address }}
SERVER_CONTEXT={{ app_context }}

# Runtime
{% if app_deployment_type == 'binary' %}
JAVA_VERSION={{ java_version }}
JVM_HEAP_MIN={{ jvm_heap_min }}
JVM_HEAP_MAX={{ jvm_heap_max }}
JVM_GC_TYPE={{ jvm_gc_type }}
{% endif %}

# Database
DB_HOST={{ db_host }}
DB_PORT={{ db_port }}
DB_NAME={{ db_name }}
DB_USER={{ db_user }}
DB_PASSWORD={{ db_password }}

# Cache
CACHE_BACKEND={{ cache_backend }}
CACHE_HOST={{ cache_host }}
CACHE_PORT={{ cache_port }}
CACHE_TTL={{ cache_ttl }}

# SSL/TLS
ENABLE_SSL={{ enable_ssl | lower }}
{% if enable_ssl %}
SSL_CERT_PATH={{ ssl_cert_path }}
SSL_KEY_PATH={{ ssl_key_path }}
{% endif %}

# Logging
LOG_DIR={{ app_log_dir }}
LOG_RETENTION_DAYS={{ app_logs_retention }}
LOG_COMPRESS={{ app_logs_compress | lower }}
LOG_FORMAT={{ app_logs_format }}

# Health checks
HEALTH_CHECK_ENABLED={{ health_check_enabled | lower }}
HEALTH_CHECK_INTERVAL={{ health_check_interval }}

# Deployment
DEPLOYMENT_TYPE={{ app_deployment_type }}
