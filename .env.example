# OpenStack Credentials (NEVER commit actual values)
# Copy to .env and populate with your credentials
# Source this file: source .env

# OpenStack Authentication
export OS_AUTH_URL="https://your-openstack.example.com:5000/v3"
export OS_USERNAME="your-username"
export OS_PASSWORD="your-password"
export OS_PROJECT="your-project"
export OS_USER_DOMAIN_NAME="Default"
export OS_PROJECT_DOMAIN_NAME="Default"
export OS_IDENTITY_API_VERSION=3

# Terraform Backend (if using remote state)
export TF_BACKEND_BUCKET="terraform-state-bucket"
export TF_BACKEND_KEY="onprem-server-builds"
export TF_BACKEND_REGION="us-east-1"

# Packer Configuration
export PACKER_LOG=1
export PACKER_LOG_PATH="packer.log"

# Ansible Configuration
export ANSIBLE_INVENTORY="infrastructure/ansible/inventories/dev.ini"
export ANSIBLE_HOST_KEY_CHECKING=False

# Build Configuration
export BUILD_ENVIRONMENT="dev"
export BUILD_VERSION="1.0.0-dev"
export IMAGE_REGISTRY="registry.example.com"
